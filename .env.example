# Copy this file to .env and fill in your own values. .env is gitignored — never commit it.

# Azure AI Speech (Cognitive Services) — https://portal.azure.com -> create a "Speech" resource.
# Free tier (F0) covers ~0.5M characters/month of neural TTS, roughly 180 minutes of narration.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=westeurope

# Gemini AI Studio (https://aistudio.google.com) — only needed for `--provider gemini`, mainly
# useful for self-serve voice cloning (see `videogen clone-voice`). Pricier than Azure for
# everyday narration and has no real word timing for captions — see providers/gemini.py.
GEMINI_API_KEY=your_gemini_api_key_here

# "azure" (default) | "gemini" | "mock" (credential-free pipeline testing, no network calls).
VIDEOGEN_TTS_PROVIDER=azure

# Where rendered videos and the TTS/layer cache are written. Both are gitignored.
VIDEOGEN_OUT_DIR=out
VIDEOGEN_CACHE_DIR=.cache
